# PostgreSQL configuration
POSTGRES_DB=meridian_db
POSTGRES_USER=meridian_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Meridian host and storage configuration
MERIDIAN_PORT=8080
MERIDIAN_DOCUMENT_STORAGE_ROOT=/var/lib/meridian/documents
MERIDIAN_FRONTEND_ALLOWED_ORIGINS=http://localhost:5173

# Identity login-protection, refresh-cookie, and persistent RS256 signing configuration
MERIDIAN_ACCOUNT_LOCKOUT_MAX_FAILED_ATTEMPTS=5
MERIDIAN_ACCOUNT_LOCKOUT_DURATION=15m
MERIDIAN_REFRESH_TOKEN_LIFETIME=7d
MERIDIAN_REFRESH_TOKEN_COOKIE_SECURE=false
MERIDIAN_JWT_PRIVATE_KEY=
MERIDIAN_JWT_PUBLIC_KEY=

# Customer encryption must decode to 32 bytes; fingerprinting must decode to at least 32 bytes
MERIDIAN_CUSTOMER_ENCRYPTION_KEY=
MERIDIAN_CUSTOMER_FINGERPRINT_KEY=

# Base64-encoded 32-byte Loan disbursement-snapshot key for the local key-ring entry
MERIDIAN_LOAN_DISBURSEMENT_SNAPSHOT_ACTIVE_KEY_ID=local
MERIDIAN_LOAN_DISBURSEMENT_SNAPSHOT_KEYS_LOCAL=
