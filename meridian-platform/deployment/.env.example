# Inventory only: copy to private operator configuration and replace every placeholder.
# Do not use local-development/test keys. Do not render resolved secrets into logs.
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_DATABASE_PASSWORD
MERIDIAN_CUSTOMER_ENCRYPTION_KEY=REPLACE_WITH_PRIVATE_BASE64_32_BYTE_KEY
MERIDIAN_CUSTOMER_FINGERPRINT_KEY=REPLACE_WITH_SEPARATE_PRIVATE_BASE64_32_BYTE_KEY
MERIDIAN_LOAN_DISBURSEMENT_SNAPSHOT_KEYS_LOCAL=REPLACE_WITH_SEPARATE_PRIVATE_BASE64_32_BYTE_KEY
MERIDIAN_JWT_PRIVATE_KEY=REPLACE_WITH_PRIVATE_BASE64_PKCS8_RSA_KEY
MERIDIAN_JWT_PUBLIC_KEY=REPLACE_WITH_MATCHING_BASE64_X509_RSA_PUBLIC_KEY
MERIDIAN_TUNNEL_TOKEN_FILE=/opt/meridian/private/tunnel-token
MERIDIAN_SMTP_PASSWORD=REPLACE_WITH_PRIVATE_RESEND_API_KEY
# Exact image ID from release.mjs build; never latest or only a Git SHA.
MERIDIAN_BACKEND_IMAGE=sha256:REPLACE_WITH_APPROVED_IMAGE_ID
# Temporary operator onboarding only. Restore false and remove identity values afterward.
MERIDIAN_ADMIN_BOOTSTRAP_ENABLED=false
MERIDIAN_ADMIN_BOOTSTRAP_EMAIL=
MERIDIAN_ADMIN_BOOTSTRAP_DISPLAY_NAME=
